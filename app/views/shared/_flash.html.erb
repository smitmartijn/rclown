<div id="flash-messages" data-turbo-permanent>
  <% flash.each do |type, message| %>
    <% css_class = case type.to_sym
      when :notice, :success then "bg-green-50 dark:bg-green-950/60 text-green-800 dark:text-green-300 border-green-200 dark:border-green-900"
      when :alert, :error then "bg-red-50 dark:bg-red-950/60 text-red-800 dark:text-red-300 border-red-200 dark:border-red-900"
      else "bg-blue-50 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300 border-blue-200 dark:border-blue-900"
      end %>
    <div class="mb-4 rounded-md border p-4 <%= css_class %>" data-controller="flash" data-flash-target="message">
      <div class="flex">
        <div class="flex-1">
          <p class="text-sm font-medium"><%= message %></p>
        </div>
        <div class="ml-3">
          <button type="button" class="inline-flex rounded-md p-1.5 hover:bg-white/50 dark:hover:bg-white/10 focus:outline-none" data-action="flash#dismiss">
            <span class="sr-only">Dismiss</span>
            <svg class="size-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  <% end %>
</div>
