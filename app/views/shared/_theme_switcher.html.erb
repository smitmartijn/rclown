<div class="theme-switcher" role="group" aria-label="Color theme">
  <button type="button" class="theme-option" data-theme-preference="auto" aria-label="Auto theme" aria-pressed="true" title="Auto: follow your system theme">
    <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v3m6-3v3m-8.25 0h10.5M4.5 3.75h15A1.5 1.5 0 0 1 21 5.25v10.5a1.5 1.5 0 0 1-1.5 1.5h-15a1.5 1.5 0 0 1-1.5-1.5V5.25a1.5 1.5 0 0 1 1.5-1.5Z" />
    </svg>
    <span class="hidden sm:inline">Auto</span>
  </button>
  <button type="button" class="theme-option" data-theme-preference="light" aria-label="Light theme" aria-pressed="false" title="Light theme">
    <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="12" cy="12" r="3.75" />
      <path stroke-linecap="round" d="M12 2.25V4.5m0 15v2.25M2.25 12H4.5m15 0h2.25M5.1 5.1l1.6 1.6m10.6 10.6 1.6 1.6m0-13.8-1.6 1.6M6.7 17.3l-1.6 1.6" />
    </svg>
    <span class="hidden sm:inline">Light</span>
  </button>
  <button type="button" class="theme-option" data-theme-preference="dark" aria-label="Dark theme" aria-pressed="false" title="Dark theme">
    <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M20.9 13.3A9 9 0 0 1 10.7 3.1 9 9 0 1 0 20.9 13.3Z" />
    </svg>
    <span class="hidden sm:inline">Dark</span>
  </button>
</div>
