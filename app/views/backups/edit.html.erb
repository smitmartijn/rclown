<% page_header "Edit Backup" %>

<div class="bg-white dark:bg-slate-900 rounded-2xl border-2 border-gray-200 dark:border-slate-700">
  <div class="px-4 py-6 sm:px-6">
    <%= render "form", backup: @backup %>
  </div>
</div>

<div class="mt-6">
  <%= button_to "Delete Backup", @backup, method: :delete, class: "text-sm text-red-600 dark:text-red-400 hover:text-red-500 dark:hover:text-red-300", data: { turbo_confirm: @backup.account_backup ? "Delete this backup and its history, and exclude its bucket from future account discovery?" : "Are you sure? This will delete all backup history." } %>
</div>
