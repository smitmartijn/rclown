<% page_header @provider.name do %>
  <% if @provider.supports_bucket_discovery? %>
    <%= link_to "Back up this account", @provider.account_backup || new_account_backup_path(provider_id: @provider.id), class: "mr-3 inline-flex items-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white" %>
  <% end %>
  <%= link_to "Edit", edit_provider_path(@provider), class: "inline-flex items-center rounded-xl border-2 border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-2.5 text-sm font-semibold text-gray-700 dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-800/60" %>
  <%= button_to "Delete", @provider, method: :delete, class: "ml-3 inline-flex items-center rounded-xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-500", data: { turbo_confirm: "Are you sure you want to delete this provider? All associated storages will also be deleted." } %>
<% end %>

<div class="space-y-6">
  <%# Provider Details %>
  <div class="bg-white dark:bg-slate-900 rounded-2xl border-2 border-gray-200 dark:border-slate-700">
    <div class="px-4 py-6 sm:px-6">
      <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100">Provider Details</h3>
    </div>
    <div class="border-t border-gray-100 dark:border-slate-800">
      <dl class="divide-y divide-gray-100 dark:divide-slate-800">
        <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-900 dark:text-slate-100">Type</dt>
          <dd class="mt-1 text-sm text-gray-700 dark:text-slate-200 sm:col-span-2 sm:mt-0">
            <span class="inline-flex items-center gap-1.5">
              <%= render "providers/icon", provider: @provider, size_class: "size-4" %>
              <%= @provider.provider_type_name %>
            </span>
          </dd>
        </div>
        <% if @provider.local? %>
          <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-900 dark:text-slate-100">Base path</dt>
            <dd class="mt-1 text-sm text-gray-700 dark:text-slate-200 sm:col-span-2 sm:mt-0 font-mono"><%= @provider.base_path %></dd>
          </div>
        <% end %>
        <% if @provider.endpoint.present? && !@provider.local? %>
          <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-900 dark:text-slate-100">Endpoint</dt>
            <dd class="mt-1 text-sm text-gray-700 dark:text-slate-200 sm:col-span-2 sm:mt-0 font-mono"><%= @provider.endpoint %></dd>
          </div>
        <% end %>
        <% if @provider.region.present? && !@provider.local? %>
          <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-900 dark:text-slate-100">Region</dt>
            <dd class="mt-1 text-sm text-gray-700 dark:text-slate-200 sm:col-span-2 sm:mt-0"><%= @provider.region %></dd>
          </div>
        <% end %>
        <% unless @provider.local? %>
          <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-900 dark:text-slate-100">Access Key ID</dt>
            <dd class="mt-1 text-sm text-gray-700 dark:text-slate-200 sm:col-span-2 sm:mt-0 font-mono">
              <%= @provider.access_key_id.first(4) %>****<%= @provider.access_key_id.last(4) %>
            </dd>
          </div>
        <% end %>
        <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-900 dark:text-slate-100">Created</dt>
          <dd class="mt-1 text-sm text-gray-700 dark:text-slate-200 sm:col-span-2 sm:mt-0"><%= @provider.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
        </div>
      </dl>
    </div>
  </div>

  <% if @provider.supports_bucket_discovery? %>
    <%# Bucket Discovery %>
    <div class="bg-white dark:bg-slate-900 rounded-2xl border-2 border-gray-200 dark:border-slate-700">
      <div class="px-4 py-6 sm:px-6 flex items-center justify-between">
        <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100">Buckets</h3>
        <%= link_to provider_buckets_path(@provider), data: { turbo_frame: dom_id(@provider, :buckets) }, class: "text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-500 dark:hover:text-blue-300" do %>
          Refresh
        <% end %>
      </div>
      <div class="border-t border-gray-100 dark:border-slate-800">
        <%= turbo_frame_tag dom_id(@provider, :buckets), src: provider_buckets_path(@provider), loading: :lazy do %>
          <div class="px-4 py-8 text-center">
            <div class="inline-block animate-spin rounded-full size-6 border-2 border-gray-300 dark:border-slate-600 border-t-blue-600"></div>
            <p class="mt-2 text-sm text-gray-500 dark:text-slate-400">Loading buckets...</p>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <p class="text-sm text-gray-600 dark:text-slate-300">This destination is ready to use. Create a backup and choose a relative destination path, such as cloudflare/my-bucket. Subdirectories are created during the backup.</p>
  <% end %>

  <%# Imported Storages %>
  <% if @provider.storages.any? %>
    <div class="bg-white dark:bg-slate-900 rounded-2xl border-2 border-gray-200 dark:border-slate-700">
      <div class="px-4 py-6 sm:px-6">
        <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100"><%= @provider.local? ? "Local Storage" : "Imported Storages" %></h3>
      </div>
      <div class="border-t border-gray-100 dark:border-slate-800">
        <ul role="list" class="divide-y divide-gray-100 dark:divide-slate-800">
          <% @provider.storages.each do |storage| %>
            <li class="flex items-center justify-between gap-x-6 px-4 py-4 sm:px-6">
              <div class="min-w-0">
                <p class="text-sm font-medium text-gray-900 dark:text-slate-100"><%= storage.name %></p>
              </div>
              <%= link_to "View", storage, class: "text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-500 dark:hover:text-blue-300" %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>
</div>
