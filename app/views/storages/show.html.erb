<% page_header @storage.name do %>
  <%= link_to "Edit", edit_storage_path(@storage), class: "inline-flex items-center rounded-xl border-2 border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-2.5 text-sm font-semibold text-gray-700 dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-800/60" %>
  <% unless @storage.in_use? %>
    <%= button_to "Delete", @storage, method: :delete, class: "ml-3 inline-flex items-center rounded-xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-500", data: { turbo_confirm: "Are you sure you want to delete this storage?" } %>
  <% end %>
<% end %>

<div class="space-y-6">
  <div class="bg-white dark:bg-slate-900 rounded-2xl border-2 border-gray-200 dark:border-slate-700">
    <div class="px-4 py-6 sm:px-6">
      <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100">Storage Details</h3>
    </div>
    <div class="border-t border-gray-100 dark:border-slate-800">
      <dl class="divide-y divide-gray-100 dark:divide-slate-800">
        <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-900 dark:text-slate-100">Provider</dt>
          <dd class="mt-1 text-sm text-gray-700 dark:text-slate-200 sm:col-span-2 sm:mt-0 flex items-center gap-2">
            <%= render "providers/icon", provider: @storage.provider, size_class: "size-4" %>
            <%= link_to @storage.provider.name, @storage.provider, class: "text-blue-600 dark:text-blue-400 hover:text-blue-500 dark:hover:text-blue-300" %>
            <span class="text-gray-400 dark:text-slate-400">(<%= @storage.provider.provider_type_name %>)</span>
          </dd>
        </div>
        <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-900 dark:text-slate-100"><%= @storage.provider.local? ? "Base path" : "Bucket" %></dt>
          <dd class="mt-1 text-sm text-gray-700 dark:text-slate-200 sm:col-span-2 sm:mt-0 font-mono"><%= @storage.root_name %></dd>
        </div>
        <% if @storage.display_name.present? %>
          <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-900 dark:text-slate-100">Display Name</dt>
            <dd class="mt-1 text-sm text-gray-700 dark:text-slate-200 sm:col-span-2 sm:mt-0"><%= @storage.display_name %></dd>
          </div>
        <% end %>
        <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-900 dark:text-slate-100">Usage Restriction</dt>
          <dd class="mt-1 text-sm sm:col-span-2 sm:mt-0">
            <% if @storage.usage_type.nil? %>
              <span class="text-gray-500 dark:text-slate-400">None (can be used as source or destination)</span>
            <% elsif @storage.usage_type_source_only? %>
              <span class="inline-flex items-center rounded-full bg-blue-100 dark:bg-blue-950/60 px-2.5 py-0.5 text-xs font-medium text-blue-800 dark:text-blue-300">Source only</span>
            <% elsif @storage.usage_type_destination_only? %>
              <span class="inline-flex items-center rounded-full bg-green-100 dark:bg-green-950/60 px-2.5 py-0.5 text-xs font-medium text-green-800 dark:text-green-300">Destination only</span>
            <% end %>
          </dd>
        </div>
        <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-900 dark:text-slate-100">Created</dt>
          <dd class="mt-1 text-sm text-gray-700 dark:text-slate-200 sm:col-span-2 sm:mt-0"><%= @storage.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
        </div>
      </dl>
    </div>
  </div>

  <% if @storage.backups.any? %>
    <div class="bg-white dark:bg-slate-900 rounded-2xl border-2 border-gray-200 dark:border-slate-700">
      <div class="px-4 py-6 sm:px-6">
        <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100">Used in Backups</h3>
      </div>
      <div class="border-t border-gray-100 dark:border-slate-800">
        <ul role="list" class="divide-y divide-gray-100 dark:divide-slate-800">
          <% @storage.backups.each do |backup| %>
            <li class="flex items-center justify-between gap-x-6 px-4 py-4 sm:px-6">
              <div class="min-w-0">
                <p class="text-sm font-medium text-gray-900 dark:text-slate-100"><%= backup.name %></p>
                <p class="text-xs text-gray-500 dark:text-slate-400">
                  <% if backup.source_storage_id == @storage.id %>
                    <span class="text-blue-600 dark:text-blue-400">Source</span>
                  <% end %>
                  <% if backup.destination_storage_id == @storage.id %>
                    <span class="text-green-600 dark:text-green-400">Destination</span>
                  <% end %>
                </p>
              </div>
              <%= link_to "View", backup, class: "text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-500 dark:hover:text-blue-300" %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>
</div>
