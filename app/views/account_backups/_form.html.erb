<%= form_with model: account_backup, class: "space-y-6" do |form| %>
  <% if account_backup.errors.any? %>
    <div class="rounded-xl border-2 border-red-200 bg-red-50 p-4">
      <ul class="list-disc list-inside text-red-700">
        <% account_backup.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>
  <p class="text-sm text-gray-600">Discover all buckets visible to the source provider's credentials. Each bucket gets an ordinary, editable backup. Defaults apply to newly created backups only.</p>

  <div>
    <%= form.label :name, class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.text_field :name, placeholder: "Cloudflare account to NAS" %>
  </div>
  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :source_provider_id, "Source provider", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.collection_select :source_provider_id, Provider.available_as_source.order(:name), :id, :name, { include_blank: "Select source provider" }, { disabled: account_backup.persisted?, required: !account_backup.persisted? } %>
    </div>
    <div>
      <%= form.label :destination_storage_id, "Destination", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.collection_select :destination_storage_id, Storage.available_as_destination.includes(:provider).order(:bucket_name), :id, ->(storage) { "#{storage.name} (#{storage.provider.name})" }, { include_blank: "Select destination" }, { required: true } %>
    </div>
  </div>
  <div>
    <%= form.label :destination_prefix, "Destination prefix", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.text_field :destination_prefix, placeholder: "Optional, e.g. cloudflare", class: "font-mono" %>
    <p class="mt-2 text-sm text-gray-500">Blank: base directory / bucket name. With a prefix: base directory / prefix / bucket name. Use distinct paths for different accounts.</p>
  </div>
  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :discovery_interval_minutes, "Discover new buckets", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.select :discovery_interval_minutes, AccountBackup::INTERVALS %>
    </div>
    <div>
      <%= form.label :schedule, "Backup schedule", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.select :schedule, Backup.schedules.keys.map { |key| [key.humanize, key] } %>
    </div>
    <div>
      <%= form.label :comparison_mode, "Comparison mode", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.select :comparison_mode, Backup.comparison_modes.keys.map { |key| [key.humanize, key] } %>
    </div>
    <div>
      <%= form.label :retention_days, "Retention days", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.number_field :retention_days, min: 1, required: true %>
    </div>
    <div>
      <%= form.label :verify_tolerance_percent, "Verification tolerance (%)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.number_field :verify_tolerance_percent, min: 0, max: 100, step: 0.01 %>
    </div>
    <div class="space-y-3">
      <div><%= form.check_box :verify_enabled %> <%= form.label :verify_enabled, "Verify after sync" %></div>
      <div><%= form.check_box :backups_enabled %> <%= form.label :backups_enabled, "Enable newly created backups" %></div>
    </div>
  </div>

  <% known_names = known_account_bucket_names(account_backup) %>
  <div class="rounded-xl border-2 border-gray-200 p-4 space-y-4">
    <h2 class="font-semibold text-gray-900">Exclude buckets</h2>
    <p class="text-sm text-gray-500">Excluded managed backups stop future runs and retention cleanup. Existing files and history stay in place. Removing a rule respects any manually disabled backups.</p>
    <%= hidden_field_tag "account_backup[excluded_buckets][]", "" %>
    <% if known_names.any? %>
      <div class="grid gap-2 sm:grid-cols-2">
        <% known_names.each_with_index do |name, index| %>
          <label class="flex items-center gap-2 text-sm text-gray-700" for="excluded_bucket_<%= index %>">
            <%= check_box_tag "account_backup[excluded_buckets][]", name, account_backup.excluded_buckets.include?(name), id: "excluded_bucket_#{index}" %>
            <span class="font-mono break-all"><%= name %></span>
          </label>
        <% end %>
      </div>
    <% end %>
    <div>
      <%= form.label :excluded_bucket_names, "Other exact bucket names", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_area :excluded_bucket_names, value: (account_backup.excluded_buckets - known_names).join("\n"), rows: 3, placeholder: "scratch-bucket", class: "font-mono" %>
    </div>
    <div>
      <%= form.label :excluded_pattern_names, "Bucket patterns", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_area :excluded_pattern_names, rows: 3, placeholder: "preview-*\n*-temporary", class: "font-mono" %>
      <p class="mt-2 text-sm text-gray-500">One rule per line. * matches any number of characters; ? matches one. Rules match the whole name, case-sensitively, including future buckets.</p>
    </div>
  </div>
  <div class="flex justify-end gap-4 border-t border-gray-200 pt-6">
    <%= link_to "Cancel", account_backup.persisted? ? account_backup : account_backups_path, class: "px-4 py-3 text-sm font-semibold text-gray-600" %>
    <%= form.submit "Save and preview", class: "rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white hover:bg-blue-500 cursor-pointer" %>
  </div>
<% end %>
